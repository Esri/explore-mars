{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "strict": true,
    "target": "ES2024",
    "outDir": "dist/js",
    "skipLibCheck": true
  },
  "include": ["types.d.ts", "./vite.config.ts", "./src/**/*"]
}
